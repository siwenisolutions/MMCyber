<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>M&amp;M Cyber Security — Advanced Security for What Matters Most</title>
<style>
  :root{
    --navy:#12213a;
    --navy-2:#0d1a2e;
    --ink:#141a24;
    --muted:#6b7280;
    --line:#e7e9ee;
    --paper:#ffffff;
    --panel:#f5f6f8;
    --gold:#e8b96a;
    --radius:18px;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  html{scroll-behavior:smooth;}
  body{
    font-family:'Inter',-apple-system,BlinkMacSystemFont,"Segoe UI",Helvetica,Arial,sans-serif;
    color:var(--ink);
    background:var(--paper);
    -webkit-font-smoothing:antialiased;
  }
  img{display:block;max-width:100%;}
  a{color:inherit;text-decoration:none;}
  .wrap{max-width:1240px;margin:0 auto;padding:0 32px;}
  .eyebrow{
    font-size:13px;
    font-weight:600;
    color:var(--muted);
    letter-spacing:.02em;
    display:flex;align-items:center;gap:8px;
    margin-bottom:14px;
  }
  .eyebrow::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--gold);display:inline-block;}
  h1,h2,h3{
    font-family:'Inter',sans-serif;
    letter-spacing:-0.02em;
    line-height:1.08;
    font-weight:650;
  }
  .btn{
    display:inline-flex;align-items:center;gap:8px;
    padding:13px 22px;
    border-radius:100px;
    font-size:14px;
    font-weight:600;
    cursor:pointer;
    border:1px solid transparent;
    transition:all .2s ease;
    white-space:nowrap;
  }
  .btn-primary{background:var(--ink);color:#fff;}
  .btn-primary:hover{background:#000;}
  .btn-light{background:#fff;color:var(--ink);}
  .btn-light:hover{background:#eee;}
  .btn-outline{background:transparent;color:#fff;border-color:rgba(255,255,255,.35);}
  .btn-outline:hover{background:rgba(255,255,255,.12);}
  .btn-outline-dark{background:transparent;color:var(--ink);border-color:var(--line);}
  .btn-outline-dark:hover{background:var(--panel);}
  .arrow{width:14px;height:14px;flex:none;}

  /* ===== HERO NAV (overlay on hero image) ===== */
  .hero-nav{
    position:absolute;top:0;left:0;right:0;z-index:6;
    padding:22px 32px;
  }
  .nav{
    display:flex;align-items:center;justify-content:space-between;
    max-width:1240px;margin:0 auto;
  }
  .brand{display:flex;align-items:center;gap:9px;font-weight:700;font-size:15px;letter-spacing:-.01em;white-space:nowrap;color:#fff;}
  .brand-mark{
    height:54px;width:auto;
    display:flex;align-items:center;justify-content:center;
    flex:0 0 auto;
  }
  .brand-mark img{height:100%;width:auto;object-fit:contain;}
  .nav-links{display:flex;align-items:center;gap:28px;font-size:14.5px;font-weight:500;color:rgba(255,255,255,.85);}
  .nav-links a{opacity:.85;transition:opacity .15s;}
  .nav-links a:hover{opacity:1;}
  .nav-cta{display:flex;align-items:center;gap:18px;}
  .nav-toggle{display:none;}

  /* ===== HERO ===== */
  .hero{
    background:linear-gradient(180deg,var(--navy) 0%,var(--navy-2) 100%);
    position:relative;
    overflow:hidden;
    border-radius:0 0 32px 32px;
    margin-bottom:64px;
  }
  .hero-inner{
    position:relative;
  }
  .hero-media{
    position:relative;
    overflow:hidden;
    height:600px;
    background:#0b1626;
  }
  .hero-media img{width:100%;height:100%;object-fit:cover;opacity:.88;}
  .hero-media::after{
    content:"";
    position:absolute;inset:0;
    background:linear-gradient(90deg, rgba(10,18,32,.92) 0%, rgba(10,18,32,.72) 30%, rgba(10,18,32,.15) 62%, rgba(10,18,32,0) 80%),
      linear-gradient(180deg, rgba(6,11,20,.65) 0%, rgba(6,11,20,0) 22%);
  }
  .hero-content{
    position:absolute;top:0;left:0;right:0;bottom:0;
    display:flex;flex-direction:column;justify-content:center;
    padding:56px 60px;
    max-width:640px;
    z-index:2;
  }
  .hero-tag{
    color:#c9a35f;
    font-size:12.5px;
    font-weight:700;
    letter-spacing:.14em;
    text-transform:uppercase;
    margin-bottom:22px;
  }
  .hero h1{
    color:#fff;
    font-size:52px;
    margin-bottom:20px;
  }
  .hero p{
    color:#b9c2d4;
    font-size:16px;
    line-height:1.6;
    max-width:420px;
    margin-bottom:32px;
  }
  .hero-actions{display:flex;gap:14px;margin-bottom:60px;}
  .btn-play{width:14px;height:14px;}
  .hero-social{display:flex;gap:16px;}
  .hero-social a{
    width:34px;height:34px;border-radius:50%;
    border:1px solid rgba(255,255,255,.25);
    display:flex;align-items:center;justify-content:center;
    color:#fff;
  }
  .hero-social svg{width:15px;height:15px;}

  .status-card{
    position:absolute;
    right:56px;bottom:56px;
    background:rgba(18,28,48,.72);
    backdrop-filter:blur(14px);
    border:1px solid rgba(255,255,255,.14);
    border-radius:16px;
    padding:18px 20px;
    width:230px;
    z-index:3;
    color:#fff;
  }
  .status-row{display:flex;align-items:center;gap:10px;margin-bottom:12px;}
  .status-row:last-child{margin-bottom:0;}
  .status-icon{
    width:30px;height:30px;border-radius:9px;
    display:flex;align-items:center;justify-content:center;
    flex:none;
  }
  .status-icon.green{background:rgba(74,222,128,.18);}
  .status-icon.gold{background:rgba(232,185,106,.18);}
  .status-icon svg{width:14px;height:14px;}
  .status-text{line-height:1.25;}
  .status-title{font-size:12.5px;font-weight:600;}
  .status-sub{font-size:11px;color:#9aa5ba;}
  .avatars{display:flex;align-items:center;margin-top:2px;}
  .avatars img{
    width:20px;height:20px;border-radius:50%;
    border:2px solid #182236;
    margin-left:-6px;
    object-fit:cover;
  }
  .avatars img:first-child{margin-left:0;}
  .avatars span{
    font-size:10.5px;color:#9aa5ba;margin-left:6px;font-weight:600;
  }

  /* generic section spacing */
  section{padding:88px 0;}
  .section-tight{padding:64px 0;}
  .col2{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:start;}

  /* ===== ABOUT / PROTECTING WHAT MATTERS ===== */
  .about-timer{
    display:flex;align-items:center;gap:14px;
    font-size:12.5px;color:var(--muted);font-weight:600;
    margin-bottom:26px;
  }
  .about-timer .num{
    color:var(--ink);font-size:13px;
  }
  .about-timer .bar{
    flex:1;height:2px;background:var(--line);position:relative;
  }
  .about-timer .bar::before{
    content:"";position:absolute;left:0;top:0;bottom:0;width:22%;background:var(--ink);
  }
  .about-lead{color:var(--muted);font-size:15px;line-height:1.65;max-width:320px;margin-bottom:44px;}
  .about-heading{font-size:34px;margin-bottom:26px;max-width:360px;}
  .about-cards{display:grid;grid-template-columns:1fr 1fr;gap:20px;}
  .about-card{
    position:relative;border-radius:18px;overflow:hidden;height:270px;
    background:#0e1522;
  }
  .about-card img{width:100%;height:100%;object-fit:cover;opacity:.75;}
  .about-card::after{
    content:"";position:absolute;inset:0;
    background:linear-gradient(180deg, rgba(10,16,28,.1) 30%, rgba(8,13,24,.92) 100%);
  }
  .about-card-body{
    position:absolute;left:0;right:0;bottom:0;padding:22px;z-index:2;color:#fff;
  }
  .about-card-icon{
    width:36px;height:36px;border-radius:50%;background:#fff;color:var(--ink);
    display:flex;align-items:center;justify-content:center;margin-bottom:70px;
  }
  .about-card-icon svg{width:16px;height:16px;}
  .about-card h4{font-size:16px;font-weight:650;margin-bottom:6px;}
  .about-card p{font-size:12.5px;color:#c3cad9;line-height:1.5;margin-bottom:14px;}
  .about-card-link{
    display:inline-flex;align-items:center;gap:8px;font-size:12.5px;font-weight:600;color:#fff;
  }
  .about-card-link .circ{
    width:22px;height:22px;border-radius:50%;border:1px solid rgba(255,255,255,.4);
    display:flex;align-items:center;justify-content:center;
  }
  .about-card-link .circ svg{width:10px;height:10px;}
  .carousel-nav{display:flex;align-items:center;justify-content:space-between;margin-top:22px;}
  .dots{display:flex;gap:6px;}
  .dots span{width:6px;height:6px;border-radius:50%;background:var(--line);}
  .dots span.active{background:var(--ink);width:16px;border-radius:3px;}
  .arrows{display:flex;gap:8px;}
  .arrows button{
    width:34px;height:34px;border-radius:50%;border:1px solid var(--line);background:#fff;
    display:flex;align-items:center;justify-content:center;cursor:pointer;
  }
  .arrows button svg{width:13px;height:13px;}

  /* ===== SMART TECH / PROMISE ===== */
  .promise{background:var(--panel);border-radius:26px;}
  .promise-inner{padding:56px;display:grid;grid-template-columns:1fr 1.1fr;gap:56px;align-items:center;}
  .promise-heading{font-size:30px;margin-bottom:16px;max-width:300px;}
  .promise p.lead{color:var(--muted);font-size:14.5px;line-height:1.6;max-width:300px;}
  .promise-video{
    position:relative;border-radius:18px;overflow:hidden;height:230px;background:#0e1522;
  }
  .promise-video img{width:100%;height:100%;object-fit:cover;}
  .promise-video::after{content:"";position:absolute;inset:0;background:rgba(8,13,22,.35);}
  .play-btn{
    position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);
    width:52px;height:52px;border-radius:50%;background:#fff;
    display:flex;align-items:center;justify-content:center;z-index:2;
  }
  .play-btn svg{width:16px;height:16px;margin-left:2px;}
  .promise-video-cap{
    position:absolute;left:20px;bottom:18px;z-index:2;color:#fff;
  }
  .promise-video-cap p{font-size:12.5px;font-weight:600;margin-bottom:8px;max-width:180px;line-height:1.4;}
  .mini-link{font-size:11.5px;font-weight:700;text-decoration:underline;}
  .promise-list{display:flex;flex-direction:column;gap:20px;}
  .promise-item{display:flex;gap:14px;align-items:flex-start;}
  .promise-item .icn{
    width:38px;height:38px;border-radius:10px;background:#fff;flex:none;
    display:flex;align-items:center;justify-content:center;border:1px solid var(--line);
  }
  .promise-item .icn svg{width:17px;height:17px;}
  .promise-item h5{font-size:14.5px;font-weight:650;margin-bottom:3px;}
  .promise-item p{font-size:12.5px;color:var(--muted);line-height:1.5;}

  /* ===== STATS ===== */
  .stats{display:flex;flex-direction:column;gap:14px;margin-top:56px;}
  .stat-row{
    display:flex;align-items:center;justify-content:space-between;
    background:var(--panel);border-radius:16px;padding:22px 26px;
  }
  .stat-left{display:flex;align-items:center;gap:16px;}
  .stat-icon{
    width:42px;height:42px;border-radius:50%;background:#fff;border:1px solid var(--line);
    display:flex;align-items:center;justify-content:center;flex:none;
  }
  .stat-icon svg{width:18px;height:18px;}
  .stat-label{font-size:13.5px;font-weight:600;line-height:1.3;max-width:170px;}
  .stat-right{display:flex;align-items:baseline;gap:10px;}
  .stat-value{font-size:26px;font-weight:700;letter-spacing:-.01em;}
  .stat-unit{font-size:11.5px;color:var(--muted);font-weight:600;}

  /* ===== SOLUTIONS GRID ===== */
  .solutions-head{display:flex;justify-content:space-between;align-items:flex-end;gap:40px;margin-bottom:40px;}
  .solutions-head h2{font-size:30px;max-width:360px;}
  .solutions-head p{color:var(--muted);font-size:14px;line-height:1.6;max-width:280px;}
  .sol-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;}
  .sol-card{border:1px solid var(--line);border-radius:18px;overflow:hidden;background:#fff;}
  .sol-media{height:160px;overflow:hidden;background:#eee;}
  .sol-media img{width:100%;height:100%;object-fit:cover;}
  .sol-body{padding:20px;}
  .sol-body h4{font-size:15px;font-weight:650;margin-bottom:6px;}
  .sol-body p{font-size:12.5px;color:var(--muted);line-height:1.5;margin-bottom:14px;}
  .sol-link{font-size:12.5px;font-weight:650;display:inline-flex;align-items:center;gap:6px;}
  .sol-link svg{width:11px;height:11px;}

  /* ===== WHY CHOOSE US ===== */
  .why{background:var(--panel);border-radius:26px;}
  .why-inner{padding:56px;}
  .why h2{font-size:28px;max-width:420px;margin-bottom:44px;}
  .why-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:32px;}
  .why-item .icn{
    width:44px;height:44px;border-radius:12px;background:#fff;border:1px solid var(--line);
    display:flex;align-items:center;justify-content:center;margin-bottom:16px;
  }
  .why-item .icn svg{width:19px;height:19px;}
  .why-item h5{font-size:14px;font-weight:650;margin-bottom:6px;}
  .why-item p{font-size:12px;color:var(--muted);line-height:1.5;}

  /* ===== TESTIMONIALS ===== */
  .testi-head{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:36px;}
  .testi-head h2{font-size:28px;max-width:420px;}
  .testi-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;align-items:center;}
  .testi-card{border:1px solid var(--line);border-radius:18px;padding:26px;background:#fff;}
  .testi-card.dark{background:var(--ink);color:#fff;border-color:var(--ink);transform:scale(1.04);}
  .stars{display:flex;gap:3px;margin-bottom:16px;color:#f5b942;}
  .stars svg{width:14px;height:14px;}
  .testi-quote{font-size:13.5px;line-height:1.6;margin-bottom:22px;}
  .testi-person{display:flex;align-items:center;gap:10px;}
  .testi-person img{width:34px;height:34px;border-radius:50%;object-fit:cover;}
  .testi-name{font-size:13px;font-weight:650;}
  .testi-role{font-size:11.5px;color:var(--muted);}
  .testi-card.dark .testi-role{color:#9aa5ba;}

  /* ===== CTA ===== */
  .cta{
    position:relative;border-radius:26px;overflow:hidden;
    min-height:520px;display:flex;align-items:center;
  }
  .cta img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;}
  .cta::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg, rgba(10,16,28,.94) 0%, rgba(10,16,28,.78) 45%, rgba(10,16,28,.35) 100%);}
  .cta-body{position:relative;z-index:2;padding:52px 56px;max-width:820px;width:100%;color:#fff;}
  .cta-body .eyebrow{color:#c9a35f;}
  .cta-body .eyebrow::before{background:#c9a35f;}
  .cta-body h2{font-size:28px;margin-bottom:14px;}
  .cta-body p{font-size:14px;color:#c3cad9;margin-bottom:20px;line-height:1.6;max-width:600px;}
  .quote-form{display:grid;grid-template-columns:1fr 1fr;gap:12px;max-width:680px;}
  .quote-field{display:flex;flex-direction:column;gap:6px;}
  .quote-field.full{grid-column:1 / -1;}
  .quote-field label{font-size:12px;font-weight:600;color:#fff;}
  .quote-field input,.quote-field textarea{
    width:100%;padding:12px 14px;border:1px solid rgba(255,255,255,.3);
    border-radius:10px;background:rgba(255,255,255,.1);color:#fff;
    font:inherit;font-size:13px;outline:none;
  }
  .quote-field input::placeholder,.quote-field textarea::placeholder{color:#c3cad9;}
  .quote-field input:focus,.quote-field textarea:focus{border-color:var(--gold);background:rgba(255,255,255,.15);}
  .quote-field textarea{min-height:92px;resize:vertical;}
  .quote-form .btn{margin-top:4px;justify-self:start;}
  .cta-shield{
    position:absolute;top:34px;right:40px;z-index:2;
    width:44px;height:44px;border-radius:50%;background:rgba(255,255,255,.12);
    display:flex;align-items:center;justify-content:center;color:#fff;
  }
  .cta-shield svg{width:18px;height:18px;}
  .section-anchor{display:block;position:relative;top:-24px;visibility:hidden;}

  /* ===== NEWSLETTER ===== */
  .news{display:grid;grid-template-columns:1.1fr .9fr;align-items:center;gap:40px;}
  .news h2{font-size:26px;max-width:340px;margin-bottom:20px;}
  .news-form{display:flex;gap:10px;max-width:380px;}
  .news-form input{
    flex:1;padding:13px 18px;border-radius:100px;border:1px solid var(--line);font-size:13.5px;outline:none;
  }
  .news-form input:focus{border-color:var(--ink);}
  .news-media{position:relative;height:260px;}
  .news-media img{width:100%;height:100%;object-fit:contain;}

  /* ===== FOOTER ===== */
  footer{background:var(--ink);color:#fff;margin-top:40px;border-radius:26px 26px 0 0;}
  .footer-inner{padding:60px 56px 32px;}
  .footer-top{display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr;gap:40px;margin-bottom:48px;}
  .footer-brand p{font-size:13px;color:#9aa5ba;line-height:1.6;margin:14px 0 20px;max-width:230px;}
  .footer-social{display:flex;gap:12px;}
  .footer-social a{
    width:32px;height:32px;border-radius:50%;border:1px solid rgba(255,255,255,.2);
    display:flex;align-items:center;justify-content:center;
  }
  .footer-social svg{width:14px;height:14px;}
  .footer-col h6{font-size:13px;font-weight:650;margin-bottom:16px;}
  .footer-col a{display:block;font-size:13px;color:#9aa5ba;margin-bottom:12px;}
  .footer-col a:hover{color:#fff;}
  .footer-bottom{
    border-top:1px solid rgba(255,255,255,.1);padding-top:24px;
    display:flex;justify-content:space-between;font-size:12px;color:#7c8598;
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 980px){
    .nav-links{display:none;}
    .col2{grid-template-columns:1fr;gap:36px;}
    .about-cards{grid-template-columns:1fr;}
    .promise-inner{grid-template-columns:1fr;padding:36px;}
    .sol-grid{grid-template-columns:1fr 1fr;}
    .why-grid{grid-template-columns:1fr 1fr;}
    .testi-grid{grid-template-columns:1fr;}
    .testi-card.dark{transform:none;}
    .news{grid-template-columns:1fr;}
    .footer-top{grid-template-columns:1fr 1fr;}
    .hero-content{padding:36px 28px;max-width:100%;}
    .hero h1{font-size:36px;}
    .hero-media{height:600px;}
    .hero-nav{padding:18px 20px;}
    .status-card{right:24px;bottom:24px;width:200px;}
    .solutions-head{flex-direction:column;align-items:flex-start;}
    .stat-row{flex-wrap:wrap;gap:12px;}
  }
  @media (max-width: 560px){
    .wrap{padding:0 18px;}
    .hero-inner{padding:0 18px;}
    .promise-inner{padding:24px;}
    .why-inner{padding:32px 24px;}
    .why-grid{grid-template-columns:1fr;}
    .sol-grid{grid-template-columns:1fr;}
    .footer-inner{padding:40px 24px 24px;}
    .footer-top{grid-template-columns:1fr;}
    .cta-body{padding:32px;}
    .quote-form{grid-template-columns:1fr;}
    .quote-field.full{grid-column:auto;}
  }
</style>
</head>
<body>

<!-- ===== HEADER ===== -->
<!-- ===== HERO ===== -->
<div class="hero">
  <div class="hero-inner">
    <div class="hero-media">
      <img src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=" alt="CCTV security camera on a city street">
      <nav class="hero-nav">
        <div class="nav">
          <div class="brand">
            <span class="brand-mark">
              <img src="data:image/png;base64," alt="M&amp;M Cyber Security logo">
            </span>
            M&amp;M Cyber Security
          </div>
          <div class="nav-links">
            <a href="#solutions">Solutions</a>
            <a href="#products">Products</a>
            <a href="#features">Features</a>
            <a href="#resources">Resources</a>
          </div>
          <div class="nav-cta">
            <a href="#quote" class="btn btn-primary">Get a Quote</a>
          </div>
        </div>
      </nav>
      <div class="hero-content">
        <h1>Advanced security for what matters most.</h1>
        <p>Smart cameras, smart doors, and motion sensors work together with 24/7 surveillance monitoring to protect your home and business.</p>
        <div class="hero-actions">
          <a href="#solutions" class="btn btn-light">Explore Solutions
            <svg class="arrow" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a href="#video" class="btn btn-outline">
            <svg class="btn-play" viewBox="0 0 24 24" fill="none"><path d="M6 4l14 8-14 8V4z" fill="currentColor"/></svg>
            Watch Video
          </a>
        </div>
